{
  "$schema": "https://schema.management.azure.com/schemas/2020-10-01/policyDefinitionRules/Microsoft.Authorization.json",
  "name": "ccc-avm-key-vault-keymgmt-cn04-premium-sku",
  "properties": {
    "displayName": "CCC.KeyMgmt.CN04 - Key vaults must use the Premium (HSM-backed) SKU",
    "description": "Audits key vaults that are not on the Premium SKU, which is required to back keys with a FIPS 140-2 Level 2/3 hardware security module. Maps to FINOS CCC KeyMgmt CN04 (Validate Imported Keys) and enforces the AVM key-vault sample setting 'sku_name = premium'.",
    "metadata": {
      "version": "1.0.0",
      "category": "Key Vault",
      "ccc_control": "CCC.KeyMgmt.CN04",
      "ccc_title": "Validate Imported Keys",
      "avm_sample": "key-vault.tfvars",
      "avm_module": "Azure/avm-res-keyvault-vault/azurerm",
      "source": "azure-policy-ccc mapping ccc-keymgmt.yaml (CCC.KeyMgmt.CN04)"
    },
    "mode": "All",
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.KeyVault/vaults"
          },
          {
            "field": "Microsoft.KeyVault/vaults/sku.name",
            "notEquals": "premium"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
