{
  "$schema": "https://schema.management.azure.com/schemas/2020-10-01/policyDefinitionRules/Microsoft.Authorization.json",
  "name": "ccc-avm-aks-core-cn03-managed-aad-azure-rbac",
  "properties": {
    "displayName": "CCC.Core.CN03 - AKS clusters must use managed Entra ID with Azure RBAC",
    "description": "Audits AKS managed clusters that do not enable managed Microsoft Entra ID integration with Azure RBAC for Kubernetes authorization. Managed Entra ID brokers access through identities where MFA / Conditional Access is enforced. Maps to FINOS CCC Core CN03 (Implement Multi-Factor Authentication) and enforces the AVM aks sample settings 'aad_profile.managed = true' and 'aad_profile.enable_azure_rbac = true'.",
    "metadata": {
      "version": "1.0.0",
      "category": "Kubernetes",
      "ccc_control": "CCC.Core.CN03",
      "ccc_title": "Implement Multi-Factor Authentication (MFA)",
      "avm_sample": "aks.tfvars",
      "avm_module": "Azure/avm-res-containerservice-managedcluster/azurerm",
      "source": "azure-policy-ccc mapping ccc-core.yaml (CCC.Core.CN03)"
    },
    "mode": "Indexed",
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.ContainerService/managedClusters"
          },
          {
            "anyOf": [
              {
                "field": "Microsoft.ContainerService/managedClusters/aadProfile.managed",
                "notEquals": "true"
              },
              {
                "field": "Microsoft.ContainerService/managedClusters/aadProfile.enableAzureRBAC",
                "notEquals": "true"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
