{
  "$schema": "https://schema.management.azure.com/schemas/2020-10-01/policyDefinitionRules/Microsoft.Authorization.json",
  "name": "ccc-avm-virtual-machine-core-cn03-managed-identity",
  "properties": {
    "displayName": "CCC.Core.CN03 - Virtual machines must use a managed identity",
    "description": "Audits virtual machines that do not have a system-assigned (or user-assigned) managed identity, the identity principal used in place of stored credentials and a prerequisite for Entra ID login with MFA enforcement. Maps to FINOS CCC Core CN03 (Implement Multi-Factor Authentication) and enforces the AVM virtual-machine sample setting 'managed_identities.system_assigned = true'.",
    "metadata": {
      "version": "1.0.0",
      "category": "Compute",
      "ccc_control": "CCC.Core.CN03",
      "ccc_title": "Implement Multi-Factor Authentication (MFA)",
      "avm_sample": "virtual-machine.tfvars",
      "avm_module": "Azure/avm-res-compute-virtualmachine/azurerm",
      "source": "azure-policy-ccc mapping ccc-vm.yaml (CCC.Core.CN03)"
    },
    "mode": "Indexed",
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "anyOf": [
              {
                "field": "identity.type",
                "exists": "false"
              },
              {
                "field": "identity.type",
                "notContains": "SystemAssigned"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
