{
  "$schema": "https://schema.management.azure.com/schemas/2020-10-01/policyDefinitionRules/Microsoft.Authorization.json",
  "name": "ccc-avm-virtual-machine-core-cn05-disable-password-auth",
  "properties": {
    "displayName": "CCC.Core.CN05 - Linux virtual machines must disable password authentication",
    "description": "Audits Linux virtual machines that allow SSH password authentication instead of key-based authentication. Maps to FINOS CCC Core CN05 (Prevent Access from Untrusted Entities) and enforces the AVM virtual-machine sample setting 'account_credentials.password_authentication_disabled = true'.",
    "metadata": {
      "version": "1.0.0",
      "category": "Compute",
      "ccc_control": "CCC.Core.CN05",
      "ccc_title": "Prevent Access from Untrusted Entities",
      "avm_sample": "virtual-machine.tfvars",
      "avm_module": "Azure/avm-res-compute-virtualmachine/azurerm",
      "source": "azure-policy-ccc mapping ccc-vm.yaml (CCC.Core.CN05)"
    },
    "mode": "Indexed",
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "field": "Microsoft.Compute/virtualMachines/osProfile.linuxConfiguration",
            "exists": "true"
          },
          {
            "field": "Microsoft.Compute/virtualMachines/osProfile.linuxConfiguration.disablePasswordAuthentication",
            "notEquals": "true"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
